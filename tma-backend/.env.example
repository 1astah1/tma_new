SERVER_PORT=8080
SERVER_HOST=0.0.0.0

DATABASE_URL=postgres://user:password@host:5432/tma_shop?sslmode=require

# Обязательные: без них сервер не стартует
JWT_SECRET=your-super-secret-key-min-32-chars-long!!
ACCOUNT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h

# production по умолчанию; development включает байпас авторизации и CORS "*"
ENVIRONMENT=production
LOG_LEVEL=info
UPLOAD_DIR=./uploads

TMA_URL=https://your-tma-url.com
ADMIN_PANEL_URL=https://your-admin-url.com

BOT_TOKEN=
BOT_WEBHOOK_URL=

# Прокси для парсера PS Store / Xbox (http:// или socks5://)
ALL_PROXY=
